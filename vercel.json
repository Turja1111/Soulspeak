{
  "version": 2,
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/backend/uploads/:path*"
    },
    {
      "source": "/((?!api|uploads|assets|static).*)",
      "destination": "/index.html"
    }
  ]
}

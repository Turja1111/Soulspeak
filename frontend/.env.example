# ──────────────────────────────────────────────────────────────────────────────
# SoulSpeak Frontend — Environment Variables
# Copy this file to .env.local for local overrides (never commit .env.local).
# ──────────────────────────────────────────────────────────────────────────────

# Set to "true" to enable demo/guest mode.
# When active, authentication is bypassed and a mock user is injected so
# recruiters can browse all features without a live backend.
# Leave unset or set to "false" for normal authenticated operation.
VITE_DEMO_MODE=false
